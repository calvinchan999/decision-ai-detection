# Copy this file to .env and replace every REPLACE_ placeholder.
# The runner loads .env from the same directory as the script, and values already
# set in the process environment take precedence over this file.
# Keep .env private: it is excluded from Git and from the Docker build context.
#
# One KEY=VALUE per line. Comments must stand on their own line, because any text
# after a value becomes part of that value. Surrounding quotes are stripped.

# --- Camera -----------------------------------------------------------------
CAMERA_RTSP_URL=rtsp://REPLACE_CAMERA_USER:REPLACE_CAMERA_PASSWORD@REPLACE_CAMERA_IP:554/REPLACE_STREAM_PATH
# FFmpeg executable if it is not on PATH
FFMPEG_PATH=ffmpeg
# Output directory for positive frames; relative paths resolve beside the script
CAPTURE_DIR=captures
# Frames pulled from FFmpeg per second; every frame goes through the YOLO gate
CAPTURE_FPS=2

# --- AI provider ------------------------------------------------------------
# cloudflare (default), openrouter, or llama_cpp
AI_PROVIDER=cloudflare
# Shared model setting: use clef or clef-flash for Cloudflare; for OpenRouter
# use a compatible Decisions model ID such as liquid/d1.1. llama_cpp uses the
# model loaded by the server, ignoring this setting.
MODEL=clef
# choice (default): one exclusive drinking / faucet / microwave / other question
# binary: three independent yes/no questions, which may all pass the threshold
QUESTION_MODE=choice
# Maximum dimensions of the JPEG sent to the AI provider; smaller frames are
# never enlarged, and the image uploaded to Azure keeps its original resolution
AI_IMAGE_MAX_WIDTH=1280
AI_IMAGE_MAX_HEIGHT=720
# Minimum seconds between AI requests, measured after a person-positive frame.
# YOLO keeps checking frames between requests; only eligible frames reach AI
AI_REQUEST_INTERVAL_SECONDS=1
# After two consecutive identical choice results, pause AI requests for this
# many seconds after the second response. Set to 0 to disable; binary is unaffected.
# No person or camera reconnection resets this cooldown and the previous choice.
AI_SAME_CHOICE_COOLDOWN_SECONDS=6
# Suppress repeat uploads per category for this many seconds; 0 uploads every
# positive frame
UPLOAD_COOLDOWN_SECONDS=0

# --- Cloudflare Workers AI (required when AI_PROVIDER=cloudflare) -----------
CLOUDFLARE_ACCOUNT_ID=REPLACE_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_CLOUDFLARE_API_TOKEN

# --- OpenRouter (required when AI_PROVIDER=openrouter) ----------------------
OPENROUTER_API_KEY=REPLACE_OPENROUTER_API_KEY

# --- Self-hosted llama.cpp (required when AI_PROVIDER=llama_cpp) -------------
# Full endpoint reachable from the application/container; use HTTPS or a VPN.
LLAMA_CPP_URL=http://REPLACE_SERVER_HOST:8080/v1/systemone
# Optional bearer token if the server is configured with an API key
LLAMA_CPP_API_KEY=
# Request timeout in seconds; increase for slower hardware
LLAMA_CPP_TIMEOUT_SECONDS=30

# --- Azure Blob Storage -----------------------------------------------------
# HTTPS container URL without a query string
AZURE_BLOB_CONTAINER_URL=https://REPLACE_STORAGE_ACCOUNT.blob.core.windows.net/REPLACE_CONTAINER
# SAS query string with create or write permission; omit the leading "?"
AZURE_BLOB_SAS_TOKEN=REPLACE_AZURE_SAS_TOKEN

# --- YOLO person gate ------------------------------------------------------
YOLO_MODEL=yolo26n.pt
YOLO_PERSON_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=960
YOLO_DEVICE=cpu

# --- Docker Compose only ---------------------------------------------------
# Host user IDs used for the captures folder; ignored when running python directly
APP_UID=1000
APP_GID=1000
